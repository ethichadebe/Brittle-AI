[Unit]
Description=Check every minute whether Accucery needs deploying

[Timer]
# First check a minute after boot, then once a minute. The script exits
# immediately when master has not moved, which is almost always.
OnBootSec=1min
OnUnitActiveSec=1min
# Without this, every reboot lines the timer up on the same second as every
# other machine's. It costs nothing here and is a good habit.
RandomizedDelaySec=15s
Persistent=true

[Install]
WantedBy=timers.target
