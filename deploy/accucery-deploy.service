[Unit]
Description=Deploy Accucery if master has moved
# Docker has to be up before the script can rebuild anything, and the fetch
# needs DNS. Neither is a hard dependency: if they are missing the script logs
# a failure and the timer tries again next minute.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/accucery
ExecStart=/usr/bin/env bash scripts/auto-deploy.sh

# A rebuild is slow. Give it room, but do not let a wedged build sit forever —
# the script's own lock would then block every later deploy.
TimeoutStartSec=30min

# The script is quiet when there is nothing to do, so anything it does print is
# worth keeping. It writes its own log as well; this catches whatever escapes.
StandardOutput=journal
StandardError=journal
