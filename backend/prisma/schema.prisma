generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model List {
  id        String     @id @default(uuid())
  storeSlug String
  name      String
  createdAt DateTime   @default(now())
  userId    String?
  items     ListItem[]

  @@map("lists")
}

// The credential a Shopper uses across devices (ADR 0003). Deliberately
// minimal — email and a password hash, nothing else — per #88's "collect
// only what #84 needs" rule.
model Account {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]

  @@map("accounts")
}

// An opaque, expiring token for one signed-in browser. The session id is
// the only thing that ever leaves the server, via an httpOnly cookie — see
// accountSession.ts.
model Session {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model PriceCache {
  storeSlug    String
  productId    String
  productName  String
  regularPrice Decimal
  loyaltyPrice Decimal?
  scrapedAt    DateTime

  @@id([storeSlug, productId])
  @@map("price_cache")
}

model ListItem {
  id          String   @id @default(uuid())
  listId      String
  productId   String
  productName String
  imageUrl    String
  regularPrice Decimal
  loyaltyPrice Decimal?
  quantity    Int      @default(1)
  isChecked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  list        List     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("list_items")
}
