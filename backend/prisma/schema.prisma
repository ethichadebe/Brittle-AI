generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model List {
  id        String     @id @default(uuid())
  storeSlug String
  name      String
  createdAt DateTime   @default(now())
  userId    String?
  // The branch this list is priced at (#131): its name and whatever the
  // store's own scraper needs to ask for it - opaque to everything else.
  // Null is the store's default (Joburg). Never coordinates: the shopper's
  // location is used once to find the branch and then discarded (POPIA).
  branch    Json?
  items     ListItem[]

  @@map("lists")
}

// The credential a Shopper uses across devices (ADR 0003). Deliberately
// minimal — email and a password hash, nothing else — per #88's "collect
// only what #84 needs" rule.
model Account {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  substituteDecisions SubstituteDecision[]
  passwordResets PasswordReset[]
  subscription  Subscription?
  premiumCheckouts PremiumCheckout[]
  premiumCharges PremiumCharge[]
  trialCards    TrialCard[]

  @@map("accounts")
}

// #171: an Account's Premium, paid through Paystack. Premium while
// accessUntil is in the future; only Paystack (its signed webhooks, or a
// transaction verified with its API) moves that forward, never the browser.
model Subscription {
  accountId        String    @id
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// "monthly" or "yearly".
  plan             String
  accessUntil      DateTime?
  /// One free trial per Account (and one per card: TrialCard).
  trialStartedAt   DateTime?
  trialEndsAt      DateTime?
  /// The card had a trial before, so this checkout had to be a paid one.
  trialRefusedAt   DateTime?
  /// Paystack's own ids, for cancelling and changing the card.
  customerCode     String?
  subscriptionCode String?   @unique
  emailToken       String?
  /// Won't renew: cancelled here, or by Paystack. Premium lasts until accessUntil.
  cancelled        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("subscriptions")
}

// #171: one Paystack checkout, so a payment is handled once whether its
// webhook or the return page arrives first, and only for the Account that
// started it.
model PremiumCheckout {
  reference String    @id
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan      String
  /// "trial": a small card check, refunded, then a subscription starting in
  /// 7 days. "subscribe": the plan's first payment, now.
  purpose   String
  createdAt DateTime  @default(now())
  handledAt DateTime?
  /// How it ended, so a reload or a late webhook gets the same answer.
  outcome   String?

  @@index([accountId])
  @@map("premium_checkouts")
}

// #171: each renewal charge, by Paystack's reference, so a webhook delivered
// twice (Paystack retries) extends Premium once.
model PremiumCharge {
  reference String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([accountId])
  @@map("premium_charges")
}

// #171: cards that have had a free trial, by Paystack's card signature (the
// same physical card has the same signature under any email). Kept, without
// the Account, when the Account is deleted: deleting and signing up again
// must not earn a second trial.
model TrialCard {
  signature String   @id
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  usedAt    DateTime @default(now())

  @@map("trial_cards")
}

// #91: a Shopper's deliberate pick or removal of one Substitute pairing —
// a product at the list's store, and a product at another store standing
// in for it. Keyed per pairing, so a Shopper holds one decision for it and
// the most recent wins. Not keyed by list: a decision follows the product
// onto every list it is on. Goes with the Account (#88).
model SubstituteDecision {
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fromStore     String
  fromProductId String
  toStore       String
  toProductId   String
  // Kept because no store can be asked for a product by its id — a chosen
  // Substitute is found again by searching for its name.
  toProductName String
  // "chosen" | "removed"
  choice        String
  decidedAt     DateTime @default(now())

  @@id([accountId, fromStore, fromProductId, toStore, toProductId])
  @@map("substitute_decisions")
}

// An opaque, expiring token for one signed-in browser. The session id is
// the only thing that ever leaves the server, via an httpOnly cookie — see
// accountSession.ts.
model Session {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model PriceCache {
  storeSlug    String
  productId    String
  productName  String
  imageUrl     String
  // Per ADR 0001: opaque, store-defined Price Zone this price was observed
  // in. Part of the key so a zone change (a new branch cookie, a different
  // Woolworths preference) never serves a price scraped for a different zone.
  zone         String
  regularPrice Decimal
  loyaltyPrice Decimal?
  scrapedAt    DateTime

  @@id([storeSlug, productId, zone])
  @@map("price_cache")
}

// #76: a row means "this store, this zone, this normalised query was
// answered completely" — the property that lets a cache hit be trusted,
// which a table keyed on product name alone cannot know. Prices are never
// duplicated here; a hit is rehydrated from price_cache by productId.
model SearchCache {
  storeSlug  String
  zone       String
  query      String
  productIds String[]
  scrapedAt  DateTime

  @@id([storeSlug, zone, query])
  @@map("search_cache")
}

model ListItem {
  id          String   @id @default(uuid())
  listId      String
  productId   String
  productName String
  imageUrl    String
  regularPrice Decimal
  loyaltyPrice Decimal?
  quantity    Int      @default(1)
  isChecked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  list        List     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("list_items")
}

// #148: a sign-up waiting for its email to be confirmed. No Account exists
// until the link is opened. Only a hash of the link's token is kept, so a
// copy of this table can't be used to confirm anything.
model PendingSignup {
  tokenHash    String   @id
  email        String
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
  @@map("pending_signups")
}

// #149: a one-time link to choose a new password. Hashed like PendingSignup,
// and gone with the Account.
model PasswordReset {
  tokenHash String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
  @@map("password_resets")
}

// #157: answers worth keeping across restarts, such as each store's default
// branch, which costs ScraperAPI credits to find. Store data only: nothing
// about any shopper.
model RememberedValue {
  key     String   @id
  value   Json
  savedAt DateTime

  @@map("remembered_values")
}

// #157: ScraperAPI credits spent, per Joburg day and purpose ("search",
// "branch"). The daily allowance is checked against it.
model CreditSpend {
  day     String
  purpose String
  count   Int    @default(0)

  @@id([day, purpose])
  @@map("credit_spend")
}

// ── Data collection ──
// Kept for later use, decided with the owner: nothing here is read by the app
// yet. Writing to these tables must never break what the shopper is doing
// (services/collect.ts swallows and logs every failure).

// Every price seen, one row per product, store, zone and Joburg day — the
// last price of the day wins. price_cache keeps only the latest price; this
// keeps them all. Store data only: nothing about any shopper.
model PriceHistory {
  storeSlug    String
  productId    String
  zone         String
  day          String
  productName  String
  regularPrice Decimal
  loyaltyPrice Decimal?
  seenAt       DateTime

  @@id([storeSlug, productId, zone, day])
  @@index([storeSlug, productId])
  @@map("price_history")
}

// Each search a shopper typed, and how many products came back. Not linked to
// who searched (the privacy notice says so).
model SearchLog {
  id          String   @id @default(uuid())
  at          DateTime @default(now())
  storeSlug   String
  query       String
  resultCount Int
  // The device was over its search limit, so only an answer already known
  // could be given.
  limited     Boolean  @default(false)

  @@index([at])
  @@map("search_log")
}

// Each comparison's outcome: what the list cost at its own store and at the
// other one, and how each item matched. Not linked to who compared.
model CompareLog {
  id           String   @id @default(uuid())
  at           DateTime @default(now())
  fromStore    String
  toStore      String
  itemCount    Int
  matchedCount Int
  // The list's own total, and the other store's total for the matched items.
  fromTotal    Decimal
  toTotal      Decimal
  // Matched items only, at their own store, so the two totals compare.
  fromMatchedTotal Decimal
  // [{ productId, productName, quantity, price, matched, toProductId?,
  //    toProductName?, cost?, source?, reason? }]
  items        Json

  @@index([at])
  @@map("compare_log")
}

// A shopper's shopping history: each item added to a list or ticked off.
// Keyed by whoever owns the list — an Account, or a device without one — and
// moved to the Account when that device signs in. Deleted when the shopper
// switches it off (HistoryOptOut) or deletes their Account.
model ShoppingEvent {
  id           String   @id @default(uuid())
  at           DateTime @default(now())
  ownerId      String
  // "added" | "ticked"
  kind         String
  // Not a relation: the history outlives the list and the item.
  listId       String
  storeSlug    String
  productId    String
  productName  String
  regularPrice Decimal
  loyaltyPrice Decimal?
  quantity     Int
  // What the browser says about the device: the phone model where Chrome
  // shares it (Sec-CH-UA-Model), else just the platform ("iPhone", "Windows").
  deviceModel  String?
  platform     String?

  @@index([ownerId, at])
  @@map("shopping_events")
}

// An Account or device that switched its shopping history off.
model HistoryOptOut {
  ownerId String   @id
  at      DateTime @default(now())

  @@map("history_opt_outs")
}
