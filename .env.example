# PostgreSQL — used by the postgres service and the backend DATABASE_URL
POSTGRES_USER=accucery
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=accucery
DATABASE_URL=postgresql://accucery:change_me_in_production@postgres:5432/accucery

# Backend — set FRONTEND_URL to your VPS domain or IP for CORS
FRONTEND_URL=http://your-vps-ip-or-domain
NODE_ENV=production

# Store scrapers. Paste the full Cookie header string copied from browser
# DevTools on that store's site; `scripts/set-store-cookie.py` does it for you.
# Only the storeContexts fragment is strictly needed — it says which physical
# store to price against — but the whole header is simplest to copy.
#
# Checkers will not return products without one. Shoprite falls back to its own
# default store, so leaving SHOPRITE_COOKIES empty works but prices may not be
# the ones your branch charges.
#
# Both hold an aws-waf-token that expires; refresh them the same way. Dollar
# signs in the value must be written as $$ or Compose eats them.
CHECKERS_COOKIES=
SHOPRITE_COOKIES=

# Routes the Checkers and Shoprite requests through a residential proxy. Required
# on a VPS: both sites' WAF blocks datacenter IPs outright. Without it the
# scrapers get a 403 no cookie can fix.
SCRAPERAPI_KEY=

# Where the frontend is published. Leave unset to bind port 80 on all
# interfaces. If this host already serves something else on 80, set it to a
# host:port that your system nginx proxies to, e.g.
#   FRONTEND_PORT=127.0.0.1:8082
# FRONTEND_PORT=
