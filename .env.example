# PostgreSQL — used by the postgres service and the backend DATABASE_URL
POSTGRES_USER=accucery
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=accucery
DATABASE_URL=postgresql://accucery:change_me_in_production@postgres:5432/accucery

# Backend — set FRONTEND_URL to your VPS domain or IP for CORS
FRONTEND_URL=http://your-vps-ip-or-domain
NODE_ENV=production

# Store scrapers. Paste the full Cookie header string copied from browser
# DevTools on that store's site; `scripts/set-store-cookie.py` does it for you.
# Only the storeContexts fragment is strictly needed — it says which physical
# store to price against — but the whole header is simplest to copy.
#
# Checkers will not return products without one. Shoprite falls back to its own
# default store, so leaving SHOPRITE_COOKIES empty works but prices may not be
# the ones your branch charges.
#
# Both hold an aws-waf-token that expires; refresh them the same way. Dollar
# signs in the value must be written as $$ or Compose eats them.
CHECKERS_COOKIES=
SHOPRITE_COOKIES=

# Routes the Checkers and Shoprite requests through a residential proxy. Required
# on a VPS: both sites' WAF blocks datacenter IPs outright. Without it the
# scrapers get a 403 no cookie can fix.
SCRAPERAPI_KEY=

# Woolworths. Not behind a WAF, so it needs no ScraperAPI credits — it is asked
# directly. It runs Constructor.io, the same search platform as Pick n Pay, and
# WOOLWORTHS_SEARCH_KEY is that platform's public client key, served to every
# visitor in woolworths.co.za's own frontend bundle. It is not a secret; it is
# here rather than in the code only because the probe that found it never
# printed it back. To read it off the site:
#   bash scripts/probe-woolworths-search.sh milk   # step [1]
WOOLWORTHS_SEARCH_KEY=

# Woolworths prices every product for several zones at once — p10, p30 and p60 —
# and they disagree: one sampled milk was 45.99 in p10 and 39.99 in p30 and p60.
# This is the same question CHECKERS_COOKIES answers via storeContexts, namely
# which branch the shopper is standing in, except Woolworths puts it in the
# payload instead of a cookie.
#
# WHICH ZONE THE SITE SHOWS AN ANONYMOUS VISITOR IS NOT YET VERIFIED. The default
# below is a guess, which is why woolworths is still active: false in
# STORE_CONFIGS. Leave this alone until that is checked — issue #27.
# WOOLWORTHS_PRICE_ZONE=p60

# Where deploy alerts go. Telegram is preferred: it is the bot this project
# already alerts through, and a chat is properly authenticated. Get the chat id
# by messaging the bot and reading
#   https://api.telegram.org/bot<TOKEN>/getUpdates
#
# Real values only. Leave them empty rather than filling in something
# placeholder-shaped; --test-notify refuses to run on a literal "...".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alternative, or as well: any endpoint that accepts a POST. https://ntfy.sh
# needs no account, but its topic name IS the password — anyone who guesses it
# can read your alerts and send you fake ones, so make it long and random:
#   ACCUCERY_NOTIFY_URL=https://ntfy.sh/accucery-$(tr -dc 'a-z0-9' < /dev/urandom | head -c 24)
ACCUCERY_NOTIFY_URL=

# With none of the above set, deploys stay silent and are recorded only in the
# log on the server. Check whichever you chose actually works, before you need
# it to:  bash scripts/auto-deploy.sh --test-notify

# Where the frontend is published. Leave unset to bind port 80 on all
# interfaces. If this host already serves something else on 80, set it to a
# host:port that your system nginx proxies to, e.g.
#   FRONTEND_PORT=127.0.0.1:8082
# FRONTEND_PORT=
