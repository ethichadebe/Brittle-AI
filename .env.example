# PostgreSQL — used by the postgres service and the backend DATABASE_URL
POSTGRES_USER=accucery
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=accucery
DATABASE_URL=postgresql://accucery:change_me_in_production@postgres:5432/accucery

# Backend — set FRONTEND_URL to your VPS domain or IP for CORS
FRONTEND_URL=http://your-vps-ip-or-domain
NODE_ENV=production

# Store scrapers, LOCAL DEV ONLY (no SCRAPERAPI_KEY): the full Cookie header
# from browser DevTools on that store's site, for its aws-waf-token, which
# lets requests from your own IP through. `scripts/set-store-cookie.py` does
# it for you. Leave both empty on a server that uses ScraperAPI.
#
# They no longer choose the branch. The scrapers look up the Joburg branch
# from the site itself, every few hours, and send it as the storeContexts
# cookie, which is what the site reads (#66). Any storeContexts pasted here
# is replaced.
#
# The token expires; refresh it the same way. Dollar signs in the value must
# be written as $$ or Compose eats them.
CHECKERS_COOKIES=
SHOPRITE_COOKIES=

# Routes the Checkers and Shoprite requests through a residential proxy. Required
# on a VPS: both sites' WAF blocks datacenter IPs outright. Without it the
# scrapers get a 403 no cookie can fix.
SCRAPERAPI_KEY=

# Woolworths. Not behind a WAF, so it needs no ScraperAPI credits — it is asked
# directly. It runs Constructor.io, the same search platform as Pick n Pay, and
# WOOLWORTHS_SEARCH_KEY is that platform's public client key, served to every
# visitor in woolworths.co.za's own frontend bundle. It is not a secret; it is
# here rather than in the code only because the probe that found it never
# printed it back. To read it off the site:
#   bash scripts/probe-woolworths-search.sh milk   # step [1]
WOOLWORTHS_SEARCH_KEY=

# Woolworths prices every product for several zones at once — p10, p30 and p60 —
# and they disagree: one sampled milk was 45.99 in p10 and 39.99 in p30 and p60.
# This is the same question CHECKERS_COOKIES answers via storeContexts, namely
# which branch the shopper is standing in, except Woolworths puts it in the
# payload instead of a cookie.
#
# VERIFIED 2026-09-21, issue #27: an anonymous visitor is shown p10. "Fresh Full
# Cream Ayrshire Milk 2 L" carries p10 45.99 / p30 39.99 / p60 39.99, and
# woolworths.co.za signed out displayed R45.99. The default was p60 until then,
# so every zone-varying product was quoted R6 under what the shopper pays.
#
# Leave this unset unless you have measured a different zone the same way — the
# scraper now defaults to p10 on its own.
# WOOLWORTHS_PRICE_ZONE=p10

# Email, through Resend (#147): sign-up confirmation and password reset.
# REQUIRED in production - the backend refuses to start without it, so a
# deploy that would break sign-up is turned away instead. Make it a "Sending
# access" key limited to the ethichadebe.me domain, in resend.com -> API Keys.
# Leave it empty locally: emails are then logged (address masked), not sent.
RESEND_API_KEY=

# Who the email comes from. Optional: defaults to Accucery <noreply@ethichadebe.me>.
# Must be on a domain verified in Resend.
# MAIL_FROM=

# Deploy alerts are NOT read from this file any more.
#
# They belonged to scripts/auto-deploy.sh, the timer-driven deploy that ran on
# the box; that path is gone and the deploy now runs in GitHub Actions
# (.github/workflows/deploy.yml -> ethichadebe/workflows compose-deploy.yml).
# It sends the same Telegram message, but reads TELEGRAM_BOT_TOKEN and
# TELEGRAM_CHAT_ID from this repository's Actions secrets, where the box cannot
# see them. Set them there, not here.
#
# ACCUCERY_NOTIFY_URL (the ntfy alternative) has no equivalent on the new path
# and is not read by anything.

# Lets this box post a command's output straight to a GitHub issue, so an agent
# session can read it instead of a person relaying terminal output by hand:
#   bash scripts/report.sh 35 -- bash scripts/probe-store.sh https://www.game.co.za
#
# Make it a fine-grained token limited to this one repository, with
# Issues: read and write and NOTHING else - specifically not Contents and not
# Workflows. This box never needs to push code, and a comment-only token cannot
# be turned into a deploy if the box is compromised.
#
# Leave it empty and report.sh simply refuses to run. See docs/agents/automation.md.
GITHUB_REPORT_TOKEN=

# Where the frontend is published. Leave unset to bind port 80 on all
# interfaces. If this host already serves something else on 80, set it to a
# host:port that your system nginx proxies to, e.g.
#   FRONTEND_PORT=127.0.0.1:8082
# FRONTEND_PORT=
